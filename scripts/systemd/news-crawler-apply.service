[Unit]
Description=Apply deferred news-crawler update when crawl is idle
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ms
WorkingDirectory=/home/ms/news-project
Environment=HOME=/home/ms
Environment=WAIT_TIMEOUT=600
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env bash /home/ms/news-project/scripts/crawler-apply.sh apply
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
